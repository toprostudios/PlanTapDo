# Local development only. Never commit real values.
DJANGO_ENVIRONMENT=development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required in staging and production. Generate independent random values with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-random-value-of-at-least-64-characters
JWT_SIGNING_KEY=replace-with-a-different-random-value-of-at-least-64-characters
# Created by supabase/provision_tenant_context.psql; use the value it prints.
DB_TENANT_CONTEXT_KEY=replace-with-128-lowercase-hex-characters
# Leave empty in development so a local-only key is derived. In staging and
# production, generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
# During rotation only; list the previous keys comma-separated, then remove
# them after affected users have re-enrolled MFA.
MFA_ENCRYPTION_KEY_FALLBACKS=

# Supabase PostgreSQL. Run supabase/bootstrap.sql before migrations.
# Runtime uses plantapdo_runtime. A migration job must instead set
# DATABASE_ROLE=migration and use plantapdo_migrator credentials.
DATABASE_ROLE=runtime
POSTGRES_DB=postgres
POSTGRES_SCHEMA=plantapdo
POSTGRES_USER=plantapdo_runtime
POSTGRES_PASSWORD=replace-with-an-independent-random-32-plus-character-password
POSTGRES_HOST=db.your-project-ref.supabase.co
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/absolute/path/to/the-downloaded-supabase-ca.crt
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=5

# Local development prints verification and recovery messages to the console.
# Staging/production must use django.core.mail.backends.smtp.EmailBackend and a
# dedicated restricted SMTP credential.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PlanTapDo <no-reply@localhost>
EMAIL_TIMEOUT=10

# Hard per-account response/storage bounds. Raise only after load testing.
ACCOUNT_CATEGORY_QUOTA=500
ACCOUNT_TODO_QUOTA=5000
ACCOUNT_TRAVEL_TIME_QUOTA=1000
ACCOUNT_TIME_SESSION_QUOTA=50000
ACCOUNT_REPEAT_RULE_QUOTA=10000
ACCOUNT_ACTIVE_SESSION_QUOTA=20

REDIS_URL=rediss://default:password@redis.internal:6379/0?ssl_cert_reqs=required&ssl_check_hostname=true
REDIS_KEY_PREFIX=plantapdo

# Enable only when the trusted reverse proxy removes client-supplied copies of
# X-Forwarded-Proto and writes its own value.
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_NUM_PROXIES=0

# Optional browser trust configuration; the native iOS app does not need it.
# Remove the development CORS origins above in production unless a web client
# is deployed, then replace them with its exact HTTPS origins.
DJANGO_CSRF_TRUSTED_ORIGINS=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0
APP_RELEASE=
