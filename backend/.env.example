# Local development only. Never commit real values.
DJANGO_ENVIRONMENT=development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required in staging and production. Generate independent random values with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-random-value-of-at-least-64-characters
JWT_SIGNING_KEY=replace-with-a-different-random-value-of-at-least-64-characters

POSTGRES_DB=plantapdo
POSTGRES_USER=plantapdo
POSTGRES_PASSWORD=replace-with-a-secret-from-your-secret-manager
POSTGRES_HOST=postgres.internal
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/absolute/path/to/the/database-ca-bundle.pem

REDIS_URL=rediss://default:password@redis.internal:6379/0?ssl_cert_reqs=required
REDIS_KEY_PREFIX=plantapdo

# Enable only when the trusted reverse proxy removes client-supplied copies of
# X-Forwarded-Proto and writes its own value.
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_NUM_PROXIES=0

# Optional browser trust configuration; the native iOS app does not need it.
# Remove the development CORS origins above in production unless a web client
# is deployed, then replace them with its exact HTTPS origins.
DJANGO_CSRF_TRUSTED_ORIGINS=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0
APP_RELEASE=
